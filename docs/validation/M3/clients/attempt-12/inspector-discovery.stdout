a-f]{32}$","type":"string"},"execution_mode":{"$ref":"#/$defs/ExecutionModeDto"},"features":{"default":[],"items":{"$ref":"#/$defs/Feature"},"maxItems":32,"type":"array"},"no_default_features":{"default":false,"type":"boolean"},"package":{"default":null,"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*$","type":["string","null"]},"target":{"default":null,"pattern":"^aarch64-unknown-linux-gnu$","type":["string","null"]},"timeout_seconds":{"default":300,"format":"uint64","maximum":3600,"minimum":1,"type":"integer"}},"required":["baseline_project_ref","candidate_project_ref"],"$defs":{"ExecutionModeDto":{"enum":["auto","task","synchronous"],"type":"string"},"Feature":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*(/[A-Za-z0-9_][A-Za-z0-9_-]*)?$","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"title":"Input"},"outputSchema":{"type":"object","properties":{"duration_ms":{"format":"uint64","minimum":0,"type":"integer"},"summary":{"type":"string"}},"required":["summary","duration_ms"],"$defs":{"Artifact":{"additionalProperties":false,"properties":{"completeness":{"$ref":"#/$defs/Completeness"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"size_bytes":{"format":"uint32","minimum":0,"type":"integer"},"uri":{"maxLength":512,"minLength":1,"type":"string"}},"required":["uri","sha256","size_bytes","completeness"],"type":"object"},"Code":{"enum":["PROJECT_NOT_FOUND","INVALID_PROJECT","COMMAND_TIMEOUT","OUTPUT_LIMIT_EXCEEDED","TOOL_NOT_INSTALLED","SANDBOX_DENIED","TASKS_REQUIRED","INCOMPLETE_EVIDENCE"],"type":"string"},"Completeness":{"enum":["complete","partial","incomplete","truncated"],"type":"string"},"Counts":{"additionalProperties":false,"properties":{"deny":{"format":"uint32","minimum":0,"type":"integer"},"warn":{"format":"uint32","minimum":0,"type":"integer"}},"required":["deny","warn"],"type":"object"},"Data":{"additionalProperties":false,"properties":{"baseline":{"$r