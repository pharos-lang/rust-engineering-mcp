orm":{"maxLength":128,"minLength":1,"type":"string"},"rust_version":{"maxLength":128,"minLength":1,"type":"string"}},"required":["platform","image_id","configuration_fingerprint","execution_fingerprint","rust_version","cargo_version"],"type":"object"},"Selection":{"additionalProperties":false,"properties":{"all_features":{"type":"boolean"},"features":{"items":{"$ref":"#/$defs/Feature"},"maxItems":32,"type":"array"},"no_default_features":{"type":"boolean"},"package":{"maxLength":128,"minLength":1,"type":["string","null"]},"target":{"pattern":"^aarch64-unknown-linux-gnu$","type":["string","null"]}},"required":["package","features","all_features","no_default_features","target"],"type":"object"},"SideEvidence":{"additionalProperties":false,"properties":{"assessed_at_unix_seconds":{"format":"uint64","minimum":0,"type":"integer"},"captured_at_unix_seconds":{"format":"uint64","minimum":0,"type":["integer","null"]},"captured_source_sha256":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"project_identity_fingerprint":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"project_ref":{"pattern":"^prj_[0-9a-f]{32}$","type":"string"}},"required":["project_ref","project_identity_fingerprint","captured_source_sha256","captured_at_unix_seconds","assessed_at_unix_seconds"],"type":"object"}},"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"properties":{"data":{"$ref":"#/$defs/Data"},"error_code":{"type":"null"},"error_message":{"type":"null"},"status":{"const":"passed","type":"string"}},"required":["status","error_code","error_message","data"],"type":"object"},{"properties":{"data":{"$ref":"#/$defs/Data"},"error_code":{"type":"null"},"error_message":{"type":"null"},"status":{"const":"failed","type":"string"}},"required":["status","error_code","error_message","data"],"type":"object"},{"properties":{"data":{"anyOf":[{"$ref":"#/$defs/Data"},{"type":"null"}]},"error_code":{"$ref":"#/$defs/Code"},"error_message":{"type":"string"},"status":{"const":"blocked","type":"string"}},"required":["status","error_code","error_message","data"],"type":"object"},{"properties":{"data":{"type":"null"},"error_code":{"$ref":"#/$defs/Code"},"error_message":{"type":"string"},"status":{"const":"unavailable","type":"string"}},"required":["status","error_code","error_message","data"],"type":"object"},{"properties":{"data":{"type":"null"},"error_code":{"type":"null"},"error_message":{"type":"null"},"status":{"const":"cancelled","type":"string"}},"required":["status","error_code","error_message","data"],"type":"object"}],"title":"Output","unevaluatedProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},{"name":"rust.mutation.test","description":"Run cargo-mutants over captured Rust source in the approved offline gateway. The baseline test run is mandatory and a failing baseline is reported as a failed outcome with its own evidence, never as a clean mutation report. Mutants are applied only inside a private writable copy in the sandbox: the captured source is mounted read-only, no mutated source is ever written back or exported, and only the machine-readable mutants.out report leaves the guest. Verdicts come only from outcomes.json plus its caught/missed/timeout/unviable lists; tool text is never an oracle. A surviving (missed) mutant fails; timeout, unviable and incomplete evidence never count as clean, and every count carries its denominator. At most 100 mutants per job with a per-mutant timeout of at most 60 seconds; a larger generated set is refused before anything is built. No mutation selection fits the 60-second synchronous budget, so auto requires negotiated MCP Tasks and task mode is accepted only when the peer declares io.modelcontextprotocol/tasks. Installs nothing and never shards.","inputSchema":{"type":"object","properties":{"all_features":{"default":false,"type":"boolean"},"execution_mode":{"$ref":"#/$defs/ExecutionModeDto"},"features":{"default":[],"items":{"$ref":"