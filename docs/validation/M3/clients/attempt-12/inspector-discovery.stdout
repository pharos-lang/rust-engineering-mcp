unevaluatedProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"rust.check","description":"Check captured Rust source using host-approved offline Cargo. Can execute build scripts and proc macros inside the calibrated sandbox. Accepts only bounded closed Cargo selections. Returns normalized diagnostics and an ephemeral owner-authorized log Resource. Project code may write the diagnostic stream; normalization does not authenticate its origin. Requires a live project_ref and completed discovery; installs nothing.","inputSchema":{"type":"object","properties":{"all_features":{"default":false,"type":"boolean"},"all_targets":{"default":false,"type":"boolean"},"features":{"default":[],"items":{"$ref":"#/$defs/Feature"},"maxItems":32,"type":"array"},"no_default_features":{"default":false,"type":"boolean"},"package":{"default":null,"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*$","type":["string","null"]},"project_ref":{"pattern":"^prj_[0-9a-f]{32}$","type":"string"},"target":{"default":null,"pattern":"^aarch64-unknown-linux-gnu$","type":["string","null"]},"workspace":{"default":false,"type":"boolean"}},"required":["project_ref"],"$defs":{"Feature":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*(/[A-Za-z0-9_][A-Za-z0-9_-]*)?$","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"title":"Input"},"outputSchema":{"type":"object","properties":{"diagnostics":{"description":"Normalized project-writable Cargo output; compiler origin is not authenticated.","items":{"$ref":"#/$defs/Diagnostic"},"maxItems":128,"type":"array"},"duration_ms":{"format":"uint64","minimum":0,"type":"integer"},"evidence":{"$ref":"#/$defs/Evidence"},"summary":{"type":"string"},"truncation":{"$ref":"#/$defs/Truncation"}},"required":["summary","duration_ms","diagnostics","truncation","evidence"],"$defs":{"Applicability":{"enum":["machine_