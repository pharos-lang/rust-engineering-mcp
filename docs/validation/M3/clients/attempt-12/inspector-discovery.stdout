sses.","inputSchema":{"type":"object","properties":{"project_ref":{"pattern":"^prj_[0-9a-f]{32}$","type":"string"}},"required":["project_ref"],"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"title":"Input"},"outputSchema":{"type":"object","properties":{"diagnostics":{"maxItems":0,"type":"array"},"duration_ms":{"format":"uint64","minimum":0,"type":"integer"},"evidence":{"$ref":"#/$defs/Evidence"},"summary":{"type":"string"},"truncation":{"$ref":"#/$defs/Truncation"}},"required":["summary","duration_ms","diagnostics","truncation","evidence"],"$defs":{"AuditFinding":{"additionalProperties":false,"properties":{"advisory_id":{"type":"string"},"informational":{"type":["string","null"]},"package":{"$ref":"#/$defs/AuditPackage"},"patched_requirements":{"items":{"type":"string"},"type":"array"},"paths":{"items":{"$ref":"#/$defs/AuditPath"},"type":"array"},"paths_omitted":{"format":"uint64","minimum":0,"type":"integer"},"severity":{"anyOf":[{"$ref":"#/$defs/AuditSeverity"},{"type":"null"}]},"title":{"type":"string"},"unaffected_requirements":{"items":{"type":"string"},"type":"array"},"url":{"type":"string"}},"required":["advisory_id","url","title","package","patched_requirements","unaffected_requirements","severity","informational","paths","paths_omitted"],"type":"object"},"AuditIssue":{"enum":["snapshot_unavailable","snapshot_stale","snapshot_unknown_age","unsupported_sources","output_budget"],"type":"string"},"AuditObservation":{"additionalProperties":false,"properties":{"crates_io_scanned":{"format":"uint32","minimum":0,"type":"integer"},"findings":{"items":{"$ref":"#/$defs/AuditFinding"},"type":"array"},"findings_omitted":{"format":"uint64","minimum":0,"type":"integer"},"informational":{"items":{"$ref":"#/$defs/AuditFinding"},"type":"array"},"issue":{"anyOf":[{"$ref":"#/$defs/AuditIssue"},{"type":"null"}]},"lock_fingerprint":{"pattern":"^sha256:[0-9a-f]{64}$","type":["string","null"]},"packages_total":{"format":"uint32","minimum":0,"