ution_fingerprint":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"image_id":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"platform":{"maxLength":4096,"type":"string"},"rust_version":{"maxLength":4096,"type":"string"}},"required":["platform","image_id","configuration_fingerprint","execution_fingerprint","rust_version","cargo_version","declared_toolchain"],"type":"object"},"Semantics":{"enum":["latest_known"],"type":"string"},"Severity":{"enum":["error","warning","note","help"],"type":"string"},"SnapshotEvidence":{"additionalProperties":false,"properties":{"freshness":{"$ref":"#/$defs/Freshness"},"provenance":{"$ref":"#/$defs/Provenance"}},"required":["provenance","freshness"],"type":"object"},"SourceKind":{"enum":["project_snapshot"],"type":"string"},"SourceSpan":{"additionalProperties":false,"properties":{"bytes":{"anyOf":[{"$ref":"#/$defs/ByteRange"},{"type":"null"}]},"end":{"$ref":"#/$defs/Position"},"file":{"maxLength":100,"minLength":1,"type":"string"},"is_primary":{"type":"boolean"},"label":{"maxLength":4096,"minLength":1,"type":["string","null"]},"start":{"$ref":"#/$defs/Position"}},"required":["file","start","end","bytes","is_primary","label"],"type":"object"},"Suggestion":{"additionalProperties":false,"properties":{"applicability":{"$ref":"#/$defs/Applicability"},"edits":{"items":{"$ref":"#/$defs/Replacement"},"maxItems":16,"minItems":1,"type":"array"},"message":{"maxLength":4096,"minLength":1,"type":"string"}},"required":["message","applicability","edits"],"type":"object"},"TestOptions":{"additionalProperties":false,"properties":{"all_features":{"type":"boolean"},"features":{"items":{"$ref":"#/$defs/Feature"},"maxItems":32,"type":"array"},"package":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*$","type":["string","null"]},"target":{"pattern":"^aarch64-unknown-linux-gnu$","type":["string","null"]},"test_filter":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_:]*$","type":["string","null"]},"timeout":{"for