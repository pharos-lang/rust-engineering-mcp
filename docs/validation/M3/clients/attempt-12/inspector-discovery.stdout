lse,"description":"Every count carries the denominator it is measured against.","properties":{"caught":{"format":"uint32","minimum":0,"type":"integer"},"generated":{"description":"Mutants generated for this selection (the listing-pass denominator).","format":"uint32","minimum":0,"type":"integer"},"missed":{"format":"uint32","minimum":0,"type":"integer"},"other":{"description":"Mutant scenarios whose recorded class is not a mutation verdict.","format":"uint32","minimum":0,"type":"integer"},"tested":{"description":"Mutant scenarios with a recorded outcome, excluding the baseline.","format":"uint32","minimum":0,"type":"integer"},"timeout":{"format":"uint32","minimum":0,"type":"integer"},"unviable":{"format":"uint32","minimum":0,"type":"integer"},"viable":{"description":"Mutants that built and ran: the denominator for `caught` and `missed`.","format":"uint32","minimum":0,"type":"integer"}},"required":["generated","tested","viable","caught","missed","timeout","unviable","other"],"type":"object"},"Data":{"additionalProperties":false,"properties":{"artifacts":{"items":{"$ref":"#/$defs/Artifact"},"maxItems":128,"type":"array"},"baseline":{"$ref":"#/$defs/Baseline"},"completeness":{"$ref":"#/$defs/Completeness"},"counts":{"$ref":"#/$defs/Counts"},"exit_code":{"format":"int32","type":["integer","null"]},"guest_identity":{"$ref":"#/$defs/GuestIdentity","description":"The guest recorded its own identity in `mutants.out/lock.json`. The file\nitself is never published; only this verdict is."},"mutants":{"items":{"$ref":"#/$defs/Mutant"},"maxItems":128,"type":"array"},"omissions":{"$ref":"#/$defs/Omissions"},"project_ref":{"pattern":"^prj_[0-9a-f]{32}$","type":"string"},"runtime":{"$ref":"#/$defs/RuntimeEvidence"},"termination":{"$ref":"#/$defs/ExecutionTermination"},"validation_complete":{"type":"boolean"}},"required":["project_ref","baseline","validation_complete","completeness","counts","mutants","guest_identity","termination","exit_code","runtime","artifacts","omissions"],"typ