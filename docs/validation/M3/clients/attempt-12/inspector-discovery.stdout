["status","error_code","error_message","data"],"type":"object"}],"title":"Output","unevaluatedProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":false,"openWorldHint":false}},{"name":"rust.test","description":"Run bounded Cargo tests on captured Rust source using host-approved offline Cargo. Executes test binaries, doctests, build scripts and proc macros inside the calibrated sandbox. Accepts closed package, test_filter, features, all_features, target and timeout selections; timeout defaults to 30 seconds and is limited to 1..60 seconds. Passed means the selected Cargo command passed, not proof that tests exist or all project tests ran. Returns reported compilation evidence, normalized diagnostics and an ephemeral owner-authorized log Resource retaining harness output; no test counts are inferred. Custom harnesses that reject the fixed test-threads/color arguments can fail. Project code can write the streams; their producer and human log section headings are not authenticated. Requires a live project_ref and completed discovery; installs nothing.","inputSchema":{"type":"object","properties":{"all_features":{"default":false,"type":"boolean"},"features":{"default":[],"items":{"$ref":"#/$defs/Feature"},"maxItems":32,"type":"array"},"package":{"default":null,"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*$","type":["string","null"]},"project_ref":{"pattern":"^prj_[0-9a-f]{32}$","type":"string"},"target":{"default":null,"pattern":"^aarch64-unknown-linux-gnu$","type":["string","null"]},"test_filter":{"default":null,"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_:]*$","type":["string","null"]},"timeout":{"default":30,"format":"uint64","maximum":60,"minimum":1,"type":"integer"}},"required":["project_ref"],"$defs":{"Feature":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*(/[A-Za-z0-9_][A-Za-z0-9_-]*)?$","type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"title":"Input"},"outputSchema":{"type":"object","properties":{"diagnostics":{"description":"Normalized project-writable Cargo output; compiler origin is not authenticated.","items":{"$ref":"#/$defs/Diagnostic"},"maxItems":128,"type":"array"},"duration_ms":{"format":"uint64","minimum":0,"type":"integer"},"evidence":{"$ref":"#/$defs/Evidence"},"summary":{"type":"string"},"truncation":{"$ref":"#/$defs/Truncation"}},"required":["summary","duration_ms","diagnostics","truncation","evidence"],"$defs":{"Applicability":{"enum":["machine_applicable","maybe_incorrect","has_placeholders","unspecified"],"type":"string"},"ByteRange":{"additionalProperties":false,"properties":{"end":{"format":"uint64","minimum":0,"type":"integer"},"start":{"format":"uint64","minimum":0,"type":"integer"}},"required":["start","end"],"type":"object"},"Code":{"enum":["PROJECT_NOT_FOUND","INVALID_PROJECT","TOOL_NOT_INSTALLED","LOCKFILE_UPDATE_REQUIRED","COMMAND_TIMEOUT","SANDBOX_DENIED","NETWORK_DENIED","UNSUPPORTED_PLATFORM","OUTPUT_LIMIT_EXCEEDED"],"type":"string"},"Data":{"additionalProperties":false,"properties":{"build_succeeded":{"description":"Reported Cargo build phase; doctests and custom harnesses may compile later.","type":["boolean","null"]},"exit_code":{"format":"int32","type":["integer","null"]},"log":{"anyOf":[{"$ref":"#/$defs/Log"},{"type":"null"}]},"log_unavailable_reason":{"anyOf":[{"$ref":"#/$defs/LogUnavailableReason"},{"type":"null"}]},"options":{"$ref":"#/$defs/TestOptions"},"project_identity_fingerprint":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"project_ref":{"pattern":"^prj_[0-9a-f]{32}$","type":"string"},"runtime":{"$ref":"#/$defs/RuntimeIdentity"},"semantics":{"$ref":"#/$defs/Semantics"},"source_fingerprint":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"termination":{"$ref":"#/$defs/ExecutionTermination"},"validation_complete":{"type":"boolean"}},"required":["project_ref","project_identity_fingerprint","semantics","options","validation_complete","build_succeeded","termination","exit_code","runtime","source_fingerprint","log","log_unavailable_reason"],"type":"object"},"Diagnostic":{"additionalProperties":false,"properties":{"code":{"maxLength":128,"minLength":1,"type":["string","null"]},"message":{"maxLength":4096,"minLength":1,"type":"string"},"rendered":{"maxLength":4096,"type":["string","null"]},"severity":{"$ref":"#/$defs/Severity"},"source":{"$ref":"#/$defs/DiagnosticSource"},"spans":{"items":{"$ref":"#/$defs/SourceSpan"},"maxItems":32,"type":"array"},"suggestions":{"items":{"$ref":"#/$defs/Suggestion"},"maxItems":16,"type":"array"},"truncated":{"type":"boolean"}},"required":["source","severity","code","message","spans","rendered","suggestions","truncated"],"type":"object"},"DiagnosticSource":{"enum":["rustc","cargo","clippy","rustfmt","rustsec"],"type":"string"},"Evidence":{"oneOf":[{"additionalProperties":false,"properties":{"kind":{"const":"local","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"properties":{"details":{"$ref":"#/$defs/SnapshotEvidence"},"kind":{"const":"snapshot","type":"string"}},"required":["kind","details"],"type":"object"}]},"ExecutionTermination":{"enum":["exited","timed_out","cancelled","output_limit"],"type":"string"},"Feature":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_][A-Za-z0-9_-]*(/[A-Za-z0-9_][A-Za-z0-9_-]*)?$","type":"string"},"Freshness":{"additionalProperties":false,"properties":{"age_seconds":{"format":"uint64","minimum":0,"type":["integer","null"]},"assessed_at":{"format":"uint64","minimum":0,"type":"integer"},"policy":{"$ref":"#/$defs/FreshnessPolicy"},"state":{"$ref":"#/$defs/FreshnessState"}},"required":["state","age_seconds","assessed_at","policy"],"type":"object"},"FreshnessPolicy":{"additionalProperties":false,"properties":{"fresh_for_seconds":{"format":"uint64","minimum":0,"type":"integer"},"id":{"maxLength":128,"minLength":1,"type":"string"},"stale_after_seconds":{"format":"uint64","minim