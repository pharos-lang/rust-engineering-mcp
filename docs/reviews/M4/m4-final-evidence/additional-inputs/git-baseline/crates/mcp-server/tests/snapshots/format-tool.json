          "freshness": {
            "$ref": "#/$defs/Freshness"
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          }
        },
        "required": [
          "provenance",
          "freshness"
        ],
        "type": "object"
      },
      "SourceKind": {
        "enum": [
          "project_snapshot"
        ],
        "type": "string"
      },
      "SourceSpan": {
        "additionalProperties": false,
        "properties": {
