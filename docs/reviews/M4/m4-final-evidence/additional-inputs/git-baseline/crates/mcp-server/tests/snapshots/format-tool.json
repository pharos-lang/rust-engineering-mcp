{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Check configured workspace formatting on captured source using host-approved offline rustfmt. Honors stable project formatting configuration and skip attributes. Accepts only a live project_ref after completed discovery. Returns bounded affected files, an untrusted display diff that must never be applied as an edit, and an ephemeral owner-authorized log Resource. Never modifies source or installs tools.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "project_ref": {
        "pattern": "^prj_[0-9a-f]{32}$",
        "type": "string"
      }
    },
    "required": [
      "project_ref"
    ],
    "title": "Input",
    "type": "object"
  },
  "name": "rust.fmt.check",
  "outputSchema": {
    "$defs": {
      "Applicability": {
        "enum": [
          "machine_applicable",
          "maybe_incorrect",
          "has_placeholders",
          "unspecified"
        ],
        "type": "string"
      },
      "ByteRange": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "start": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "CapturedPath": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
        "type": "string"
      },
      "Code": {
        "enum": [
          "PROJECT_NOT_FOUND",
          "INVALID_PROJECT",
          "TOOL_NOT_INSTALLED",
          "LOCKFILE_UPDATE_REQUIRED",
          "COMMAND_TIMEOUT",
          "SANDBOX_DENIED",
          "NETWORK_DENIED",
          "UNSUPPORTED_PLATFORM",
          "OUTPUT_LIMIT_EXCEEDED"
        ],
        "type": "string"
      },
      "Data": {
        "additionalProperties": false,
        "properties": {
          "affected_files": {
            "description": "Captured relative paths; these strings confer no filesystem authority.",
            "items": {
              "$ref": "#/$defs/CapturedPath"
            },
            "maxItems": 128,
            "type": "array"
          },
          "affected_files_omitted": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "diff": {
            "description": "Untrusted display only; never apply this diff as an edit.",
            "maxLength": 32768,
            "type": [
              "string",
              "null"
            ]
          },
          "diff_omitted": {
            "type": "boolean"
          },
          "exit_code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "log": {
            "anyOf": [
              {
                "$ref": "#/$defs/Log"
              },
              {
                "type": "null"
              }
            ]
          },
          "log_unavailable_reason": {
            "anyOf": [
              {
                "$ref": "#/$defs/LogUnavailableReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "project_identity_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "project_ref": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "type": "string"
          },
          "runtime": {
            "$ref": "#/$defs/RuntimeIdentity"
          },
          "semantics": {
            "$ref": "#/$defs/Semantics"
          },
          "source_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "termination": {
            "$ref": "#/$defs/ExecutionTermination"
          },
          "validation_complete": {
            "type": "boolean"
          }
        },
        "required": [
          "project_ref",
          "project_identity_fingerprint",
          "semantics",
          "affected_files",
          "affected_files_omitted",
          "diff",
          "diff_omitted",
          "validation_complete",
          "termination",
          "exit_code",
          "runtime",
          "source_fingerprint",
          "log",
          "log_unavailable_reason"
        ],
        "type": "object"
      },
      "Diagnostic": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "rendered": {
            "maxLength": 4096,
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          },
          "source": {
            "$ref": "#/$defs/DiagnosticSource"
          },
          "spans": {
            "items": {
              "$ref": "#/$defs/SourceSpan"
            },
            "maxItems": 32,
            "type": "array"
          },
          "suggestions": {
            "items": {
              "$ref": "#/$defs/Suggestion"
            },
            "maxItems": 16,
            "type": "array"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "severity",
          "code",
          "message",
          "spans",
          "rendered",
          "suggestions",
          "truncated"
        ],
        "type": "object"
      },
      "DiagnosticSource": {
        "enum": [
          "rustc",
          "cargo",
          "clippy",
          "rustfmt",
          "rustsec"
        ],
        "type": "string"
      },
      "Evidence": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "local",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "details": {
                "$ref": "#/$defs/SnapshotEvidence"
              },
              "kind": {
                "const": "snapshot",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "details"
            ],
            "type": "object"
          }
        ]
      },
      "ExecutionTermination": {
        "enum": [
          "exited",
          "timed_out",
          "cancelled",
          "output_limit"
        ],
        "type": "string"
      },
      "Freshness": {
        "additionalProperties": false,
        "properties": {
          "age_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "assessed_at": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "policy": {
            "$ref": "#/$defs/FreshnessPolicy"
          },
          "state": {
            "$ref": "#/$defs/FreshnessState"
          }
        },
        "required": [
          "state",
          "age_seconds",
          "assessed_at",
          "policy"
        ],
        "type": "object"
      },
      "FreshnessPolicy": {
        "additionalProperties": false,
        "properties": {
          "fresh_for_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "stale_after_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "fresh_for_seconds",
          "stale_after_seconds"
        ],
        "type": "object"
      },
      "FreshnessState": {
        "enum": [
          "live",
          "fresh",
          "aging",
          "stale",
          "unknown"
        ],
        "type": "string"
      },
      "IntegrityStatus": {
        "enum": [
          "verified",
          "unverified",
          "failed",
          "unknown"
        ],
        "type": "string"
      },
      "Log": {
        "additionalProperties": false,
        "properties": {
          "retention_remaining_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "format": "uint32",
            "maximum": 262144,
            "minimum": 0,
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "uri": {
            "pattern": "^rust-artifact://prj_[0-9a-f]{32}/art_[0-9a-f]{32}$",
            "type": "string"
          }
        },
        "required": [
          "uri",
          "sha256",
          "size_bytes",
          "truncated",
          "retention_remaining_seconds"
        ],
        "type": "object"
      },
      "LogUnavailableReason": {
        "enum": [
          "retention_capacity"
        ],
        "type": "string"
      },
      "Position": {
        "additionalProperties": false,
        "properties": {
          "column": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "line": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "line",
          "column"
        ],
        "type": "object"
      },
      "Provenance": {
        "additionalProperties": false,
        "properties": {
