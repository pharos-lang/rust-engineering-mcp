            },
            "type": "array"
          },
          "validation_complete": {
            "type": "boolean"
          },
          "workspace_packages_excluded": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "state",
          "issue",
          "validation_complete",
          "lock_fingerprint",
          "snapshot_fingerprint",
          "snapshot",
          "snapshot_record_count",
          "snapshot_sequence",
          "packages_total",
          "crates_io_scanned",
          "workspace_packages_excluded",
          "unsupported_packages",
          "findings",
          "informational",
          "findings_omitted"
        ],
        "type": "object"
      },
      "AuditPackage": {
        "additionalProperties": false,
