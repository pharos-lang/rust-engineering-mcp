        "type": "string"
      },
      "AppliedSelection": {
        "enum": [
          "format_all",
          "check_cargo_defaults",
          "clippy_strict_cargo_defaults",
          "test_cargo_defaults_30_seconds",
          "audit_captured_lockfile"
