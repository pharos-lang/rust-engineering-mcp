              "string",
              "null"
            ]
          },
          "package": {
            "$ref": "#/$defs/AuditPackage"
          },
          "patched_requirements": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "paths": {
            "items": {
              "$ref": "#/$defs/AuditPath"
            },
            "type": "array"
          },
          "paths_omitted": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "severity": {
            "anyOf": [
              {
                "$ref": "#/$defs/AuditSeverity"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "unaffected_requirements": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "advisory_id",
          "url",
          "title",
          "package",
          "patched_requirements",
          "unaffected_requirements",
          "severity",
          "informational",
          "paths",
          "paths_omitted"
        ],
        "type": "object"
      },
      "AuditIssue": {
        "enum": [
          "snapshot_unavailable",
          "snapshot_stale",
          "snapshot_unknown_age",
