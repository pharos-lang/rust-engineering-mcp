            "type": "integer"
          },
          "runtime": {
            "$ref": "#/$defs/RuntimeIdentity"
          },
          "unsupported_packages_omitted": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "runtime",
          "observation",
          "unsupported_packages_omitted",
          "paths_omitted"
        ],
        "type": "object"
      },
      "AuditFinding": {
        "additionalProperties": false,
        "properties": {
          "advisory_id": {
