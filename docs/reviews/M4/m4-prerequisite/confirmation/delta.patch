 class GateReportingTests(unittest.TestCase):
+    def test_required_sonar_configuration_is_bound_through_real_git_inventory(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            subprocess.run(['git', '-c', 'init.defaultBranch=fixture', 'init', '--quiet', str(root)],
+                           check=True, capture_output=True)
+            policy = root / 'sonar-project.properties'
+            policy.write_text('sonar.coverage.exclusions=\n')
+            before = GATE.source_inventory(root, os.environ)
+            self.assertEqual([row['path'] for row in before], ['sonar-project.properties'])
+            policy.write_text('sonar.coverage.exclusions=crates/**\n')
+            after = GATE.source_inventory(root, os.environ)
+            self.assertNotEqual(before[0]['sha256'], after[0]['sha256'])
+
+    def test_portable_product_paths_cannot_be_excluded_from_required_coverage(self):
+        root = Path(__file__).resolve().parents[1]
+        properties = dict(line.split('=', 1) for line in
+                          (root / 'sonar-project.properties').read_text().splitlines()
+                          if line and not line.startswith('#') and '=' in line)
+        excluded = [pattern for key in ['sonar.exclusions', 'sonar.coverage.exclusions']
+                    for pattern in properties.get(key, '').split(',') if pattern]
+        coverage_excluded = properties.get('sonar.coverage.exclusions', '').split(',')
+        for source in sorted(root.glob('crates/*/src/**/*.rs')):
+            path = source.relative_to(root).as_posix()
+            self.assertFalse(any(fnmatch.fnmatchcase(path, pattern)
+                                 for pattern in coverage_excluded if pattern),
+                             f'Rust source {path} is excluded from coverage')
+        portable = [
+            'crates/execution-adapter/src/lib.rs',
+            'crates/execution-adapter/src/mutation_gateway.rs',
+            'crates/execution-adapter/src/mutation_test_gateway.rs',
+            'crates/execution-adapter/src/nextest_gateway.rs',
+            'crates/execution-adapter/src/coverage_gateway.rs',
+            'crates/execution-adapter/src/resolution_gateway.rs',
+            'crates/execution-adapter/src/project_inspection.rs',
+            'crates/execution-adapter/src/nextest_port.rs',
+            'crates/execution-adapter/src/mutation_test_port.rs',
+            'crates/mcp-server/src/stdio.rs',
+            'crates/mcp-server/src/main.rs',
+        ]
+        for path in portable:
+            with self.subTest(path=path):
+                self.assertTrue((root / path).is_file())
+                self.assertFalse(any(fnmatch.fnmatchcase(path, pattern) for pattern in excluded),
+                                 f'{path} is portable product code excluded from coverage')
+
