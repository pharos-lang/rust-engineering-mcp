{
  "name": "rust.crate.inspect",
  "description": "Inspect authoritative SQLite crate facts by section and exact version. Continue pages with the returned snapshot fingerprint and next offset. Missing documentation or package source stays unknown; listed advisory IDs do not establish safety. No downloads, refresh, model requirement or project authority.",
  "inputSchema": {
    "$defs": {
      "InspectSection": {
        "enum": [
          "overview",
          "versions",
          "features",
          "dependencies",
          "advisories"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "default": 20,
        "format": "uint32",
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "name": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "offset": {
        "default": 0,
        "format": "uint32",
        "maximum": 128,
        "minimum": 0,
        "type": "integer"
      },
      "section": {
        "$ref": "#/$defs/InspectSection",
        "default": "overview"
      },
      "snapshot_fingerprint": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": [
          "string",
          "null"
        ]
      },
      "version": {
        "maxLength": 128,
        "minLength": 1,
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "name"
    ],
    "title": "Input",
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "AdvisoryInterpretation": {
        "enum": [
          "snapshot_listed_ids_only"
        ],
        "type": "string"
      },
      "Code": {
        "enum": [
          "SANDBOX_DENIED",
          "COMMAND_TIMEOUT",
          "OUTPUT_LIMIT_EXCEEDED",
          "CATALOG_UNAVAILABLE",
          "CATALOG_INVALID",
          "SNAPSHOT_MISMATCH"
        ],
        "type": "string"
      },
      "Coverage": {
        "enum": [
          "snapshot_page_only"
        ],
        "type": "string"
      },
      "CrateInspectResult": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "$ref": "#/$defs/SnapshotEvidence"
          },
          "lookup": {
            "$ref": "#/$defs/InspectLookup"
          },
          "name": {
            "type": "string"
          },
          "sequence": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "snapshot_fingerprint": {
            "$ref": "#/$defs/Fingerprint"
          }
        },
        "required": [
          "name",
          "snapshot_fingerprint",
          "sequence",
          "evidence",
          "lookup"
        ],
        "type": "object"
      },
      "Data": {
        "additionalProperties": false,
        "properties": {
          "advisory_interpretation": {
            "$ref": "#/$defs/AdvisoryInterpretation"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "inspection": {
            "$ref": "#/$defs/CrateInspectResult"
          },
          "semantics": {
            "$ref": "#/$defs/Semantics"
          }
        },
        "required": [
          "semantics",
          "coverage",
          "advisory_interpretation",
          "inspection"
        ],
        "type": "object"
      },
      "DependencyKind": {
        "enum": [
          "normal",
          "build",
          "dev"
        ],
        "type": "string"
      },
      "DependencyRecord": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/$defs/DependencyKind"
          },
          "name": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "requirement": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "requirement",
          "kind",
          "optional"
        ],
        "type": "object"
      },
      "Fingerprint": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "Freshness": {
        "additionalProperties": false,
        "properties": {
          "age_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "assessed_at": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "policy": {
            "$ref": "#/$defs/FreshnessPolicy"
          },
          "state": {
            "$ref": "#/$defs/FreshnessState"
          }
        },
        "required": [
          "state",
          "age_seconds",
          "assessed_at",
          "policy"
        ],
        "type": "object"
      },
      "FreshnessPolicy": {
        "additionalProperties": false,
        "properties": {
          "fresh_for_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "stale_after_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "fresh_for_seconds",
          "stale_after_seconds"
        ],
        "type": "object"
      },
      "FreshnessState": {
        "enum": [
          "live",
          "fresh",
          "aging",
          "stale",
          "unknown"
        ],
        "type": "string"
      },
      "InspectLookup": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "crate_not_found",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "version_not_found",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "found",
                "type": "string"
              },
              "page": {
                "$ref": "#/$defs/InspectPage"
              }
            },
            "required": [
              "kind",
              "page"
            ],
            "type": "object"
          }
        ]
      },
      "InspectOverview": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "documentation": {
            "$ref": "#/$defs/InspectUnknown"
          },
          "latest_known_stable": {
            "anyOf": [
              {
                "$ref": "#/$defs/KnownVersion"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/$defs/InspectUnknown"
          },
          "updated_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "version_count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "description",
          "repository",
          "updated_at",
          "latest_known_stable",
          "version_count",
          "documentation",
          "source"
        ],
        "type": "object"
      },
      "InspectPage": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/$defs/InspectPageData"
          },
          "overview": {
            "$ref": "#/$defs/InspectOverview"
          },
          "pagination": {
            "$ref": "#/$defs/InspectPagination"
          }
        },
        "required": [
          "overview",
          "data",
          "pagination"
        ],
        "type": "object"
      },
      "InspectPageData": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "section": {
                "const": "overview",
                "type": "string"
              },
              "selected_version": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/InspectVersion"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "section",
              "selected_version"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/InspectVersion"
                },
                "type": "array"
              },
              "section": {
                "const": "versions",
                "type": "string"
              }
            },
            "required": [
              "section",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "section": {
                "const": "features",
                "type": "string"
              },
              "version": {
                "$ref": "#/$defs/InspectVersion"
              }
            },
            "required": [
              "section",
              "version",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/DependencyRecord"
                },
                "type": "array"
              },
              "section": {
                "const": "dependencies",
                "type": "string"
              },
              "version": {
                "$ref": "#/$defs/InspectVersion"
              }
            },
            "required": [
              "section",
              "version",
              "items"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "section": {
                "const": "advisories",
                "type": "string"
              },
              "version": {
                "$ref": "#/$defs/InspectVersion"
              }
            },
            "required": [
              "section",
              "version",
              "items"
            ],
            "type": "object"
          }
        ]
      },
      "InspectPagination": {
        "additionalProperties": false,
        "properties": {
          "next_offset": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "omitted_by_output": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "returned": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "total": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "offset",
          "total",
          "returned",
          "next_offset",
          "omitted_by_output"
        ],
        "type": "object"
      },
      "InspectUnknown": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "$ref": "#/$defs/InspectUnknownReason"
              },
              "status": {
                "const": "unknown",
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "type": "object"
          }
        ]
      },
      "InspectUnknownReason": {
        "enum": [
          "not_recorded_in_snapshot"
        ],
        "type": "string"
      },
      "InspectVersion": {
        "additionalProperties": false,
        "properties": {
          "advisory_count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "dependency_count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "feature_count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "rust_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          },
          "yanked": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "yanked",
          "rust_version",
          "license",
          "published_at",
          "feature_count",
          "dependency_count",
          "advisory_count"
        ],
        "type": "object"
      },
      "IntegrityStatus": {
        "enum": [
          "verified",
          "unverified",
          "failed",
          "unknown"
        ],
        "type": "string"
      },
      "KnownVersion": {
        "additionalProperties": false,
        "properties": {
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "rust_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          },
          "yanked": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "yanked",
          "rust_version",
          "license"
        ],
        "type": "object"
      },
      "LocalEvidence": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "local",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "Provenance": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "integrity": {
            "$ref": "#/$defs/IntegrityStatus"
          },
          "network_used": {
            "type": "boolean"
          },
          "observed_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "source_id": {
            "minLength": 1,
            "type": "string"
          },
          "source_kind": {
            "$ref": "#/$defs/SourceKind"
          }
        },
        "required": [
          "source_kind",
          "source_id",
          "created_at",
          "observed_at",
          "integrity",
          "network_used"
        ],
        "type": "object"
      },
      "Semantics": {
        "enum": [
          "latest_known"
        ],
        "type": "string"
      },
      "SnapshotEvidence": {
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "$ref": "#/$defs/Freshness"
          },
          "provenance": {
            "$ref": "#/$defs/Provenance"
          }
        },
        "required": [
          "provenance",
          "freshness"
        ],
        "type": "object"
      },
      "SourceKind": {
        "enum": [
          "registry_snapshot",
          "project_snapshot",
          "rustsec_snapshot",
          "embedding_model",
          "artifact"
        ],
        "type": "string"
      },
      "Truncation": {
        "additionalProperties": false,
        "properties": {
          "diagnostics_omitted": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "stderr_truncated": {
            "type": "boolean"
          },
          "stdout_truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "stdout_truncated",
          "stderr_truncated",
          "diagnostics_omitted"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "data": {
            "$ref": "#/$defs/Data"
          },
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          },
          "status": {
            "const": "passed",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "type": "null"
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "blocked",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "type": "null"
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "unavailable",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          },
          "status": {
            "const": "cancelled",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      }
    ],
    "properties": {
      "diagnostics": {
        "maxItems": 0,
        "type": "array"
      },
      "duration_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "evidence": {
        "$ref": "#/$defs/LocalEvidence"
      },
      "summary": {
        "type": "string"
      },
      "truncation": {
        "$ref": "#/$defs/Truncation"
      }
    },
    "required": [
      "summary",
      "duration_ms",
      "diagnostics",
      "truncation",
      "evidence"
    ],
    "title": "Output",
    "type": "object",
    "unevaluatedProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
