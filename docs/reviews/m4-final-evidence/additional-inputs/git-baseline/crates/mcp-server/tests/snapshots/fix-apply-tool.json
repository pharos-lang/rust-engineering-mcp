{
  "name": "rust.fix.apply",
  "description": "Preview, commit or inspect a journaled cargo fix operation on existing Rust source. Host --allow-fix-write is required. The fixed offline sandbox command selects all workspace targets and default features, then independently checks the complete candidate. Project build scripts and proc macros may influence permitted source changes; review the exact diff. No edition migration, broken-code or arbitrary flags. New effects require an unexpired approved plan and an idempotency key. Exact ID/digest/key can replay an existing journal under current authority. Commit invalidates its input project_ref: call rust.project.open and use its newly returned data.project_ref for ALL later calls, including receipt/recovery; never reuse the precommit reference. Local coordinated publication does not exclude external editors or provide multi-file atomicity.",
  "inputSchema": {
    "$defs": {
      "FormatAction": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "expected_project_fingerprint": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "mode": {
                "const": "preview",
                "type": "string"
              }
            },
            "required": [
              "mode",
              "expected_project_fingerprint"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "idempotency_key": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              "mode": {
                "const": "commit",
                "type": "string"
              },
              "plan_digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "plan_id": {
                "pattern": "^mut_[0-9a-f]{32}$",
                "type": "string"
              }
            },
            "required": [
              "mode",
              "plan_id",
              "plan_digest",
              "idempotency_key"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "receipt",
                "type": "string"
              },
              "operation_id": {
                "pattern": "^mut_[0-9a-f]{32}$",
                "type": "string"
              },
              "recover": {
                "type": "boolean"
              }
            },
            "required": [
              "mode",
              "operation_id",
              "recover"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "action": {
        "$ref": "#/$defs/FormatAction"
      },
      "project_ref": {
        "pattern": "^prj_[0-9a-f]{32}$",
        "type": "string"
      }
    },
    "required": [
      "project_ref",
      "action"
    ],
    "title": "FixInput",
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Change": {
        "additionalProperties": false,
        "properties": {
          "after_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "after_sha256": {
            "type": "string"
          },
          "before_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "before_sha256": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "before_sha256",
          "after_sha256",
          "before_bytes",
          "after_bytes"
        ],
        "type": "object"
      },
      "Concurrency": {
        "enum": [
          "local_coordinated"
        ],
        "type": "string"
      },
      "Data": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "diff": {
                "type": "string"
              },
              "expires_in_seconds": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "files": {
                "items": {
                  "$ref": "#/$defs/Change"
                },
                "type": "array"
              },
              "kind": {
                "const": "preview",
                "type": "string"
              },
              "plan_digest": {
                "type": "string"
              },
              "plan_id": {
                "type": "string"
              },
              "validation": {
                "$ref": "#/$defs/ValidationView"
              }
            },
            "required": [
              "kind",
              "plan_id",
              "plan_digest",
              "expires_in_seconds",
              "files",
              "diff",
              "validation"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "files": {
                "items": {
                  "$ref": "#/$defs/ReceiptChange"
                },
                "type": "array"
              },
              "kind": {
                "const": "receipt",
                "type": "string"
              },
              "operation_id": {
                "type": "string"
              },
              "plan_digest": {
                "type": "string"
              },
              "state": {
                "$ref": "#/$defs/ReceiptState"
              },
              "validation": {
                "$ref": "#/$defs/ValidationView"
              }
            },
            "required": [
              "kind",
              "operation_id",
              "plan_digest",
              "state",
              "validation",
              "files"
            ],
            "type": "object"
          }
        ]
      },
      "ExcludedGuarantee": {
        "enum": [
          "os_exclusion_of_external_writers",
          "multi_file_atomicity",
          "malicious_host_protection",
          "demonstrated_power_loss_survival"
        ],
        "type": "string"
      },
      "Freshness": {
        "enum": [
          "unknown"
        ],
        "type": "string"
      },
      "LockDisposition": {
        "enum": [
          "updated_existing",
          "transient_unpublished"
        ],
        "type": "string"
      },
      "LockPolicy": {
        "enum": [
          "preserve_presence"
        ],
        "type": "string"
      },
      "MutationEvidence": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "local",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "freshness": {
                "$ref": "#/$defs/Freshness"
              },
              "kind": {
                "const": "mutation_snapshot",
                "type": "string"
              },
              "plan_digest": {
                "type": "string"
              },
              "semantics": {
                "$ref": "#/$defs/SnapshotSemantics"
              }
            },
            "required": [
              "kind",
              "plan_digest",
              "semantics",
              "freshness"
            ],
            "type": "object"
          }
        ]
      },
      "Reason": {
        "enum": [
          "invalid_operation",
          "permission_denied",
          "conflict",
          "lock_busy",
          "plan_expired",
          "not_found",
          "limit_exceeded",
          "unsupported_platform",
          "io",
          "recovery_required",
          "toolchain_unavailable",
          "candidate_invalid",
          "cancelled",
          "command_timeout",
          "offline_data_missing",
          "offline_data_invalid"
        ],
        "type": "string"
      },
      "ReceiptChange": {
        "additionalProperties": false,
        "properties": {
          "before_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "before_sha256": {
            "type": "string"
          },
          "effect_after_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "effect_after_sha256": {
            "description": "Effect recorded at the terminal journal phase, not current live state.",
            "type": [
              "string",
              "null"
            ]
          },
          "intended_after_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "intended_after_sha256": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "before_sha256",
          "intended_after_sha256",
          "before_bytes",
          "intended_after_bytes",
          "effect_after_sha256",
          "effect_after_bytes"
        ],
        "type": "object"
      },
      "ReceiptState": {
        "enum": [
          "committed",
          "no_change",
          "aborted",
          "recovery_required"
        ],
        "type": "string"
      },
      "ResolutionView": {
        "additionalProperties": false,
        "properties": {
          "dataset_fingerprint": {
            "type": "string"
          },
          "lock_disposition": {
            "$ref": "#/$defs/LockDisposition"
          },
          "lock_policy": {
            "$ref": "#/$defs/LockPolicy"
          },
          "manifest_path": {
            "type": "string"
          },
          "resolution_execution_fingerprint": {
            "type": "string"
          },
          "resolved_lock_fingerprint": {
            "type": "string"
          }
        },
        "required": [
          "resolution_execution_fingerprint",
          "dataset_fingerprint",
          "resolved_lock_fingerprint",
          "lock_policy",
          "lock_disposition",
          "manifest_path"
        ],
        "type": "object"
      },
      "SnapshotSemantics": {
        "enum": [
          "latest_known"
        ],
        "type": "string"
      },
      "Status": {
        "enum": [
          "passed",
          "failed",
          "blocked",
          "unavailable",
          "cancelled"
        ],
        "type": "string"
      },
      "Truncation": {
        "additionalProperties": false,
        "properties": {
          "diagnostics_omitted": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "stderr_truncated": {
            "type": "boolean"
          },
          "stdout_truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "stdout_truncated",
          "stderr_truncated",
          "diagnostics_omitted"
        ],
        "type": "object"
      },
      "ValidationMethod": {
        "enum": [
          "cargo_metadata_frozen_no_deps",
          "rustfmt_then_fmt_check",
          "cargo_fix_then_check",
          "cargo_metadata_offline_then_frozen"
        ],
        "type": "string"
      },
      "ValidationView": {
        "additionalProperties": false,
        "properties": {
          "candidate_source_fingerprint": {
            "type": "string"
          },
          "cargo_version": {
            "type": "string"
          },
          "configuration_fingerprint": {
            "type": "string"
          },
          "execution_fingerprint": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "method": {
            "$ref": "#/$defs/ValidationMethod"
          },
          "mutation_execution_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "type": "string"
          },
          "resolution": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResolutionView"
              },
              {
                "type": "null"
              }
            ]
          },
          "rust_version": {
            "type": "string"
          },
          "semantics": {
            "$ref": "#/$defs/SnapshotSemantics"
          }
        },
        "required": [
          "method",
          "semantics",
          "platform",
          "image_id",
          "configuration_fingerprint",
          "execution_fingerprint",
          "rust_version",
          "cargo_version",
          "candidate_source_fingerprint",
          "mutation_execution_fingerprint",
          "resolution"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "concurrency_contract": {
        "$ref": "#/$defs/Concurrency"
      },
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/Data"
          },
          {
            "type": "null"
          }
        ]
      },
      "diagnostics": {
        "maxItems": 0,
        "type": "array"
      },
      "duration_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "error_code": {
        "anyOf": [
          {
            "$ref": "#/$defs/Reason"
          },
          {
            "type": "null"
          }
        ]
      },
      "error_message": {
        "type": [
          "string",
          "null"
        ]
      },
      "evidence": {
        "$ref": "#/$defs/MutationEvidence"
      },
      "guarantees_not_provided": {
        "items": {
          "$ref": "#/$defs/ExcludedGuarantee"
        },
        "maxItems": 4,
        "minItems": 4,
        "type": "array"
      },
      "status": {
        "$ref": "#/$defs/Status"
      },
      "summary": {
        "type": "string"
      },
      "truncation": {
        "$ref": "#/$defs/Truncation"
      }
    },
    "required": [
      "status",
      "error_code",
      "error_message",
      "summary",
      "duration_ms",
      "data",
      "diagnostics",
      "truncation",
      "evidence",
      "concurrency_contract",
      "guarantees_not_provided"
    ],
    "title": "Output",
    "type": "object"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
