{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Read symbols from a captured Rust project using the host-approved rust-analyzer 1.98.1 (aarch64-unknown-linux-gnu) inside the M6 guest image. Snapshot semantics are latest_known and non-atomic: the capture is not a live filesystem view. Build scripts, proc macros and check-on-save stay disabled; only textDocument/documentSymbol or workspace/symbol run, never cargo check. Results are bounded to 512 visible entries per call; an over-budget answer is reported incomplete, never silently truncated. Positions are Unicode-scalar, 1-based Position values, never byte offsets or UTF-16 units. Requires the host --rust runtime configured with the approved M6 image; without it the tool is unavailable. Hover, go-to-definition and rename are not offered by this or any other tool.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "file": {
            "pattern": "^[A-Za-z0-9_./-]{1,100}\\.rs$",
            "type": "string"
          },
          "scope": {
            "const": "document",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "file"
        ],
        "type": "object"
      },
      {
        "properties": {
          "query": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "const": "workspace",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "query"
        ],
        "type": "object"
      }
    ],
    "properties": {
      "expected_project_fingerprint": {
        "default": null,
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": [
          "string",
          "null"
        ]
      },
      "project_ref": {
        "pattern": "^prj_[0-9a-f]{32}$",
        "type": "string"
      },
      "timeout_seconds": {
        "default": 60,
        "format": "uint32",
        "maximum": 180,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "project_ref"
    ],
    "title": "Input",
    "type": "object",
    "unevaluatedProperties": false
  },
  "name": "rust.analyzer.symbols",
  "outputSchema": {
    "$defs": {
      "Analyzer": {
        "additionalProperties": false,
        "properties": {
          "binary_sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "config_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "image_id": {
            "minLength": 1,
            "type": "string"
          },
          "position_encoding": {
            "anyOf": [
              {
                "$ref": "#/$defs/PositionEncoding"
              },
              {
                "type": "null"
              }
            ],
            "description": "`None` exactly when `initialize` never answered: no negotiation\nhappened, so no encoding is published."
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "version",
          "binary_sha256",
          "image_id",
          "config_digest",
          "position_encoding"
        ],
        "type": "object"
      },
      "Code": {
        "enum": [
          "CONFLICT",
          "FILE_NOT_IN_SNAPSHOT",
          "ANALYZER_NOT_READY",
          "ANALYZER_CRASHED",
          "ANALYZER_CAPABILITY_MISMATCH",
          "FRAME_LIMIT",
          "MESSAGE_LIMIT",
          "RESULT_LIMIT",
          "TIMEOUT_INITIALIZE",
          "TIMEOUT_QUERY",
          "TIMEOUT_TOTAL",
          "UNSUPPORTED_PROJECT_CONFIG",
          "FILE_NOT_UTF8",
          "SANDBOX_DENIED",
          "UNSUPPORTED_PLATFORM",
          "PROJECT_NOT_FOUND",
          "INVALID_PROJECT",
          "OUTPUT_LIMIT_EXCEEDED"
        ],
        "type": "string"
      },
      "Completeness": {
        "additionalProperties": false,
        "properties": {
          "omissions": {
            "items": {
              "$ref": "#/$defs/Omission"
            },
            "maxItems": 8,
            "type": "array"
          },
          "reasons": {
            "items": {
              "$ref": "#/$defs/Reason"
            },
            "maxItems": 8,
            "type": "array"
          },
          "state": {
            "$ref": "#/$defs/CompletenessState"
          }
        },
        "required": [
          "state",
          "omissions",
          "reasons"
        ],
        "type": "object"
      },
      "CompletenessState": {
        "enum": [
          "complete",
          "incomplete"
        ],
        "type": "string"
      },
      "Data": {
        "additionalProperties": false,
        "properties": {
          "analyzer": {
            "$ref": "#/$defs/Analyzer"
          },
          "completeness": {
            "$ref": "#/$defs/Completeness"
          },
          "exit_code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "limits": {
            "$ref": "#/$defs/Limits"
          },
          "omitted": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "oom_killed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "project_identity_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "project_ref": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "type": "string"
          },
          "readiness": {
            "$ref": "#/$defs/Readiness"
          },
          "session": {
            "$ref": "#/$defs/Session"
          },
          "snapshot": {
            "$ref": "#/$defs/Snapshot"
          },
          "symbols": {
            "anyOf": [
              {
                "$ref": "#/$defs/Symbols"
              },
              {
                "type": "null"
              }
            ],
            "description": "`None` exactly when the session never answered \u2014 `data` is still\npublished (identity, readiness, completeness, session) but there is no\nresult to report."
          },
          "termination": {
            "$ref": "#/$defs/Termination"
          },
          "toolchain": {
            "$ref": "#/$defs/Toolchain"
          }
        },
        "required": [
          "project_ref",
          "project_identity_fingerprint",
          "snapshot",
          "analyzer",
          "toolchain",
          "readiness",
          "completeness",
          "limits",
          "session",
          "termination",
          "exit_code",
          "oom_killed",
          "symbols",
          "omitted"
        ],
        "type": "object"
      },
      "DocumentSymbol": {
        "additionalProperties": false,
        "description": "A flattened `textDocument/documentSymbol` entry (ADR-083 \u00a74).\n\n`name`'s bound (256 Unicode scalars, no control character) mirrors\n`lsp_codec::MAX_PEER_NAME_CHARS` (V05 P2), a different crate this schema\nmodule may not depend on; the pattern below excludes only the C0 control\nrange and DEL (JSON Schema `pattern` need not support the Unicode\nproperty classes `char::is_control` covers), so it is a best-effort mirror\n\u2014 the actual bound is enforced in Rust by `lsp_codec`, not by this schema.",
        "properties": {
          "deprecated": {
            "type": "boolean"
          },
          "depth": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "detail": {
            "maxLength": 1024,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "detail_truncated": {
            "description": "`true` when `detail` is a prefix of what the peer actually sent (V05\nP2): always `false` when `detail` is absent.",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/$defs/SymbolKind"
          },
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "range": {
            "$ref": "#/$defs/Range"
          },
          "selection_range": {
            "$ref": "#/$defs/Range"
          }
        },
        "required": [
          "depth",
          "name",
          "kind",
          "detail",
          "detail_truncated",
          "deprecated",
          "range",
          "selection_range"
        ],
        "type": "object"
      },
      "Health": {
        "enum": [
          "ok",
          "warning"
        ],
        "type": "string"
      },
      "Limits": {
        "additionalProperties": false,
        "properties": {
          "frame_bytes": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "initialize_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "max_visible": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "messages": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "query_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "total_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_visible",
          "initialize_timeout_seconds",
          "query_timeout_seconds",
          "total_timeout_seconds",
          "frame_bytes",
          "messages"
        ],
        "type": "object"
      },
      "Omission": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "$ref": "#/$defs/OmissionKind"
          }
        },
        "required": [
          "kind",
          "count"
        ],
        "type": "object"
      },
      "OmissionKind": {
        "description": "Mirrors `rust_engineering_domain::OmissionKind` 1:1; only `limit_visible`\nand `not_utf8_file` are reachable from this tool's converter today, but the\nfull closed set is modelled so a future gateway change needs no schema\nedit here. `oversized_entry` (V05 P2) is enforced by `lsp_codec` at the\npeer boundary, but the M6-01 gateway still folds that count into\n`limit_visible` pending a change to `analyzer_gateway.rs::record_omissions`\nthat reports it under this variant instead.",
        "enum": [
          "external_uri",
          "sysroot_location",
          "dependency_location",
          "limit_visible",
          "not_utf8_file",
          "unresolvable_position",
          "oversized_entry"
        ],
        "type": "string"
      },
      "Position": {
        "additionalProperties": false,
        "properties": {
          "column": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "line": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "line",
          "column"
        ],
        "type": "object"
      },
      "PositionEncoding": {
        "enum": [
          "utf-8",
          "utf-16"
        ],
        "type": "string"
      },
      "Range": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "$ref": "#/$defs/Position"
          },
          "start": {
            "$ref": "#/$defs/Position"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Readiness": {
        "additionalProperties": false,
        "properties": {
          "elapsed_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "health": {
            "anyOf": [
              {
                "$ref": "#/$defs/Health"
              },
              {
                "type": "null"
              }
            ],
            "description": "`Some` only for `state: quiescent`: a never-ready session observed no\nserver health at all, and inventing one would be a claim the adapter\ncannot support."
          },
          "state": {
            "$ref": "#/$defs/ReadinessState"
          }
        },
        "required": [
          "state",
          "health",
          "elapsed_ms"
        ],
        "type": "object"
      },
      "ReadinessState": {
        "enum": [
          "quiescent",
          "not_ready"
        ],
        "type": "string"
      },
      "Reason": {
        "description": "Mirrors `rust_engineering_domain::IncompleteReason`, plus this tool's own\n`result_limit`: the 512 KiB output trim (D2) has no domain reason of its\nown because it never reaches the analyzer session at all.",
        "enum": [
          "analyzer_not_ready",
          "limit_visible",
          "analyzer_warning",
          "not_utf8_file",
          "timeout",
          "result_limit"
        ],
        "type": "string"
      },
      "Semantics": {
        "enum": [
          "latest_known"
        ],
        "type": "string"
      },
      "Session": {
        "additionalProperties": false,
        "properties": {
          "bytes_in": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "bytes_out": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "messages_in": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "messages_out": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "server_requests": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "stderr_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "messages_in",
          "messages_out",
          "bytes_in",
          "bytes_out",
          "duration_ms",
          "stderr_bytes",
          "server_requests"
        ],
        "type": "object"
      },
      "Snapshot": {
        "additionalProperties": false,
        "properties": {
          "atomic": {
            "type": "boolean"
          },
          "files": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "semantics": {
            "$ref": "#/$defs/Semantics"
          },
          "source_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "source_fingerprint",
          "files",
          "semantics",
          "atomic"
        ],
        "type": "object"
      },
      "SymbolKind": {
        "description": "The closed LSP 3.17 `SymbolKind` set, mirroring\n`rust_engineering_domain::SymbolKind` 1:1.",
        "enum": [
          "file",
          "module",
          "namespace",
          "package",
          "class",
          "method",
          "property",
          "field",
          "constructor",
          "enum",
          "interface",
          "function",
          "variable",
          "constant",
          "string",
          "number",
          "boolean",
          "array",
          "object",
          "key",
          "null",
          "enum_member",
          "struct",
          "event",
          "operator",
          "type_parameter"
        ],
        "type": "string"
      },
      "Symbols": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/DocumentSymbol"
            },
            "type": "array"
          },
          {
            "items": {
              "$ref": "#/$defs/WorkspaceSymbol"
            },
            "type": "array"
          }
        ],
        "description": "The shape of `data.symbols` depends on the requested scope: a document\nscope answers with a flattened symbol tree, a workspace scope with a flat\nsearch result. Never both, matching the single query the session ran."
      },
      "Sysroot": {
        "enum": [
          "present"
        ],
        "type": "string"
      },
      "Termination": {
        "enum": [
          "exited",
          "timed_out",
          "cancelled",
          "output_limit"
        ],
        "type": "string"
      },
      "Toolchain": {
        "additionalProperties": false,
        "properties": {
          "rust_version": {
            "type": "string"
          },
          "sysroot": {
            "$ref": "#/$defs/Sysroot"
          }
        },
        "required": [
          "rust_version",
          "sysroot"
        ],
        "type": "object"
      },
      "WorkspaceSymbol": {
        "additionalProperties": false,
        "description": "A `workspace/symbol` entry, always under `/source` (ADR-083 \u00a74). `name`\nand `container` share [`DocumentSymbol::name`]'s peer-text bound.",
        "properties": {
          "container": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/SymbolKind"
          },
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "range": {
            "$ref": "#/$defs/Range"
          }
        },
        "required": [
          "name",
          "kind",
          "container",
          "file",
          "range"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "data": {
            "$ref": "#/$defs/Data"
          },
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          },
          "status": {
            "const": "passed",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/$defs/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "blocked",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/$defs/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "unavailable",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          },
          "status": {
            "const": "cancelled",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      }
    ],
    "properties": {
      "duration_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "summary",
      "duration_ms"
    ],
    "title": "Output",
    "type": "object",
    "unevaluatedProperties": false
  }
}
