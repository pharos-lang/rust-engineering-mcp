      "Omission": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "$ref": "#/$defs/OmissionKind"
          }
        },
        "required": [
