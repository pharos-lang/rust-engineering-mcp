{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Preview (ADR-086): Read native rust-analyzer diagnostics for a captured Rust file, using the host-approved rust-analyzer 1.98.1 (aarch64-unknown-linux-gnu) inside the M6 guest image. Snapshot semantics are latest_known and non-atomic. Build scripts, proc macros and check-on-save stay disabled; only the pull textDocument/diagnostic request runs, never cargo check — these are analyzer-native diagnostics, distinct from rust.check. Results are bounded to 512 visible entries per call; an over-budget answer is reported incomplete, never silently truncated. message is project-derived text, bounded to 4,096 Unicode scalars with message_truncated flagging a cut and control characters other than newline/tab replaced; it is never the server's own status message or stderr. Requires the host --rust runtime configured with the approved M6 image; without it the tool is unavailable.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "expected_project_fingerprint": {
        "default": null,
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": [
          "string",
          "null"
        ]
      },
      "file": {
        "pattern": "^[A-Za-z0-9_./-]{1,100}\\.rs$",
        "type": "string"
      },
      "project_ref": {
        "pattern": "^prj_[0-9a-f]{32}$",
        "type": "string"
      },
      "timeout_seconds": {
        "default": 60,
        "format": "uint32",
        "maximum": 180,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "project_ref",
      "file"
    ],
    "title": "DiagnosticsInput",
    "type": "object"
  },
  "name": "rust.analyzer.diagnostics",
  "outputSchema": {
    "$defs": {
      "Analyzer": {
        "additionalProperties": false,
        "properties": {
          "binary_sha256": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "config_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "image_id": {
            "minLength": 1,
            "type": "string"
          },
          "position_encoding": {
            "anyOf": [
              {
                "$ref": "#/$defs/PositionEncoding"
              },
              {
                "type": "null"
              }
            ],
            "description": "`None` exactly when `initialize` never answered: no negotiation\nhappened, so no encoding is published."
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "version",
          "binary_sha256",
          "image_id",
          "config_digest",
          "position_encoding"
        ],
        "type": "object"
      },
      "AnalyzerDiagnostic": {
        "additionalProperties": false,
        "description": "A native rust-analyzer diagnostic (ADR-083 §2, M6-03). `message` is\nproject-derived text: bounded to 4,096 Unicode scalars and flagged\n`message_truncated` rather than silently cut, never the serverStatus\n`message` or stderr.",
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "message_truncated": {
            "type": "boolean"
          },
          "range": {
            "$ref": "#/$defs/Range"
          },
          "related": {
            "items": {
              "$ref": "#/$defs/RelatedInformation"
            },
            "maxItems": 32,
            "type": "array"
          },
          "severity": {
            "$ref": "#/$defs/DiagnosticSeverity"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "file",
          "range",
          "severity",
          "code",
          "source",
          "message",
          "message_truncated",
          "related"
        ],
        "type": "object"
      },
      "Completeness": {
        "additionalProperties": false,
        "properties": {
          "omissions": {
            "items": {
              "$ref": "#/$defs/Omission"
            },
            "maxItems": 8,
            "type": "array"
          },
          "reasons": {
            "items": {
              "$ref": "#/$defs/Reason"
            },
            "maxItems": 8,
            "type": "array"
          },
          "state": {
            "$ref": "#/$defs/CompletenessState"
          }
        },
        "required": [
          "state",
          "omissions",
          "reasons"
        ],
        "type": "object"
      },
      "CompletenessState": {
        "enum": [
          "complete",
          "incomplete"
        ],
        "type": "string"
      },
      "DiagnosticSeverity": {
        "description": "Mirrors `rust_engineering_domain::DiagnosticSeverity` 1:1.",
        "enum": [
          "error",
          "warning",
          "information",
          "hint"
        ],
        "type": "string"
      },
      "DiagnosticsCode": {
        "enum": [
