            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "initialize_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "max_visible": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "messages": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
