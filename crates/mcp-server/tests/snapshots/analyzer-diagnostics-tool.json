          "FILE_NOT_IN_SNAPSHOT",
          "ANALYZER_NOT_READY",
          "ANALYZER_CRASHED",
          "ANALYZER_CAPABILITY_MISMATCH",
          "FRAME_LIMIT",
          "MESSAGE_LIMIT",
          "RESULT_LIMIT",
          "TIMEOUT_INITIALIZE",
          "TIMEOUT_QUERY",
          "TIMEOUT_TOTAL",
          "UNSUPPORTED_PROJECT_CONFIG",
          "FILE_NOT_UTF8",
          "SANDBOX_DENIED",
          "UNSUPPORTED_PLATFORM",
          "PROJECT_NOT_FOUND",
          "INVALID_PROJECT",
          "OUTPUT_LIMIT_EXCEEDED"
        ],
        "type": "string"
      },
      "DiagnosticsData": {
        "additionalProperties": false,
        "properties": {
          "analyzer": {
            "$ref": "#/$defs/Analyzer"
          },
          "completeness": {
            "$ref": "#/$defs/Completeness"
          },
          "diagnostics": {
            "description": "`None` exactly when the session never answered.",
            "items": {
              "$ref": "#/$defs/AnalyzerDiagnostic"
            },
            "maxItems": 512,
            "type": [
              "array",
              "null"
            ]
          },
          "exit_code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "limits": {
            "$ref": "#/$defs/Limits"
          },
          "omitted": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "oom_killed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "project_identity_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "project_ref": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "type": "string"
          },
          "readiness": {
            "$ref": "#/$defs/Readiness"
          },
          "session": {
            "$ref": "#/$defs/Session"
          },
          "snapshot": {
            "$ref": "#/$defs/Snapshot"
          },
          "termination": {
            "$ref": "#/$defs/Termination"
          },
          "toolchain": {
            "$ref": "#/$defs/Toolchain"
          }
        },
        "required": [
          "project_ref",
          "project_identity_fingerprint",
          "snapshot",
          "analyzer",
          "toolchain",
          "readiness",
          "completeness",
          "limits",
          "session",
          "termination",
          "exit_code",
          "oom_killed",
          "diagnostics",
          "omitted"
        ],
        "type": "object"
      },
      "Health": {
        "enum": [
          "ok",
          "warning"
        ],
        "type": "string"
      },
      "Limits": {
        "additionalProperties": false,
        "properties": {
