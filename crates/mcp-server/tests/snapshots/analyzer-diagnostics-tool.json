            "minimum": 0,
            "type": "integer"
          },
          "total_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "max_visible",
          "initialize_timeout_seconds",
          "query_timeout_seconds",
          "total_timeout_seconds",
          "frame_bytes",
          "messages"
        ],
        "type": "object"
