{
  "name": "rust.benchmark.compare",
  "description": "Compare two benchmark datasets this project already published, by their opaque store identifiers. Runs no process and reads no project source, so it has no execution mode. Publishes the complete frozen method (median of per-iteration time, percentile bootstrap, fixed seed, confidence level, multiplicity correction, material threshold, outliers counted and never removed) and, per shared benchmark, the verdict, effect ratio, interval, both medians, both sample counts, both outlier counts, the minimum detectable ratio and the reasons any verdict was withheld. Datasets that do not describe comparable executions are an observed result carrying the complete sorted reason list, not an infrastructure failure. The result describes these two executions on this host: it attributes no cause, generalizes to no other hardware and recommends nothing.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "baseline_artifact_id": {
        "description": "Opaque, store-issued and not composable by the peer.",
        "pattern": "^qart_[0-9a-f]{32}$",
        "type": "string"
      },
      "candidate_artifact_id": {
        "pattern": "^qart_[0-9a-f]{32}$",
        "type": "string"
      },
      "project_ref": {
        "pattern": "^prj_[0-9a-f]{32}$",
        "type": "string"
      },
      "timeout_seconds": {
        "default": 30,
        "format": "uint64",
        "maximum": 30,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "project_ref",
      "baseline_artifact_id",
      "candidate_artifact_id"
    ],
    "title": "Input",
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Code": {
        "enum": [
          "SANDBOX_DENIED",
          "ARTIFACT_UNAVAILABLE",
          "ARTIFACT_NOT_FOUND",
          "ARTIFACT_UNREADABLE",
          "ARTIFACT_TOO_LARGE",
          "NOT_A_DATASET",
          "INVALID_DATASET",
          "NO_COMMON_BENCHMARK",
          "INCOMPATIBLE_DATASETS",
          "COMMAND_TIMEOUT",
          "OUTPUT_LIMIT_EXCEEDED",
          "EVIDENCE_INCOMPLETE"
        ],
        "type": "string"
      },
      "Comparison": {
        "additionalProperties": false,
        "description": "One benchmark compared across the two datasets. When the verdict is\n`inconclusive` for a missing measurement the numeric fields carry zeros:\na zero here is an absence, not an observation of no difference.",
        "properties": {
          "baseline_median_ns": {
            "format": "double",
            "type": "number"
          },
          "baseline_outliers": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "baseline_samples": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_median_ns": {
            "format": "double",
            "type": "number"
          },
          "candidate_outliers": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_samples": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "confidence_interval": {
            "$ref": "#/$defs/Interval"
          },
          "effect_ratio": {
            "description": "`candidate_median_ns / baseline_median_ns - 1`. A positive value means\nthe candidate measurement is the slower of the two.",
            "format": "double",
            "type": "number"
          },
          "inconclusive_reasons": {
            "items": {
              "$ref": "#/$defs/InconclusiveReason"
            },
            "maxItems": 6,
            "type": "array"
          },
          "key": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minimum_detectable_ratio": {
            "description": "The smallest true ratio this sample size and dispersion could detect at\nthe adjusted level with 80% power. It is never equated to the threshold.",
            "format": "double",
            "type": "number"
          },
          "verdict": {
            "$ref": "#/$defs/Verdict"
          }
        },
        "required": [
          "key",
          "verdict",
          "effect_ratio",
          "confidence_interval",
          "baseline_median_ns",
          "candidate_median_ns",
          "baseline_samples",
          "candidate_samples",
          "baseline_outliers",
          "candidate_outliers",
          "minimum_detectable_ratio",
          "inconclusive_reasons"
        ],
        "type": "object"
      },
      "Data": {
        "additionalProperties": false,
        "properties": {
          "baseline_artifact_id": {
            "pattern": "^qart_[0-9a-f]{32}$",
            "type": "string"
          },
          "candidate_artifact_id": {
            "pattern": "^qart_[0-9a-f]{32}$",
            "type": "string"
          },
          "project_ref": {
            "pattern": "^prj_[0-9a-f]{32}$",
            "type": "string"
          },
          "report": {
            "$ref": "#/$defs/Report"
          },
          "semantics": {
            "type": "string"
          }
        },
        "required": [
          "project_ref",
          "semantics",
          "baseline_artifact_id",
          "candidate_artifact_id",
          "report"
        ],
        "type": "object"
      },
      "IncompatibilityReason": {
        "description": "Why two datasets may not be compared at all. Checked before any statistic is\ncomputed, and reported in full, sorted and deduplicated.",
        "enum": [
          "format_version",
          "unit",
          "harness",
          "harness_version",
          "benchmark_identity",
          "rust_version",
          "cargo_version",
          "runtime_image",
          "platform",
          "architecture",
          "cpu_model",
          "quotas",
          "selection",
          "sampling_mode",
          "unknown_hardware",
          "same_artifact"
        ],
        "type": "string"
      },
      "InconclusiveReason": {
        "description": "Why a verdict was withheld for one benchmark.",
        "enum": [
          "insufficient_samples",
          "precision_below_threshold",
          "interval_spans_threshold",
          "zero_or_negative_baseline",
          "missing_measurement",
          "truncated_measurement"
        ],
        "type": "string"
      },
      "Interval": {
        "additionalProperties": false,
        "description": "Percentile bootstrap interval for the effect ratio at the adjusted level.",
        "properties": {
          "high": {
            "format": "double",
            "type": "number"
          },
          "low": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "low",
          "high"
        ],
        "type": "object"
      },
      "Method": {
        "additionalProperties": false,
        "description": "The frozen method, published with every report so a reader can reproduce it.",
        "properties": {
          "adjusted_confidence_level": {
            "format": "double",
            "type": "number"
          },
          "bootstrap_resamples": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "confidence_level": {
            "format": "double",
            "type": "number"
          },
          "family_size": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "material_threshold_ratio": {
            "format": "double",
            "type": "number"
          },
          "method": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "multiplicity": {
            "$ref": "#/$defs/Multiplicity"
          },
          "outlier_policy": {
            "$ref": "#/$defs/OutlierPolicy"
          },
          "seed": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "statistic": {
            "$ref": "#/$defs/Statistic"
          }
        },
        "required": [
          "method",
          "statistic",
          "bootstrap_resamples",
          "seed",
          "confidence_level",
          "material_threshold_ratio",
          "multiplicity",
          "family_size",
          "adjusted_confidence_level",
          "outlier_policy"
        ],
        "type": "object"
      },
      "Multiplicity": {
        "description": "Multiplicity correction applied to the family of benchmarks in one report.",
        "enum": [
          "none",
          "bonferroni"
        ],
        "type": "string"
      },
      "OutlierPolicy": {
        "description": "Outliers are counted with Tukey fences and reported; they are never removed\nfrom the sample set the statistic is computed over.",
        "enum": [
          "reported_not_removed"
        ],
        "type": "string"
      },
      "Report": {
        "additionalProperties": false,
        "properties": {
          "baseline_only": {
            "description": "Benchmark keys present only in the baseline dataset, sorted.",
            "items": {
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          "baseline_only_omitted": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_only": {
            "description": "Benchmark keys present only in the candidate dataset, sorted.",
            "items": {
              "type": "string"
            },
            "maxItems": 256,
            "type": "array"
          },
          "candidate_only_omitted": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "compared": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "comparisons": {
            "items": {
              "$ref": "#/$defs/Comparison"
            },
            "maxItems": 512,
            "type": "array"
          },
          "comparisons_omitted": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "complete": {
            "description": "False whenever this response describes less than the comparison produced.",
            "type": "boolean"
          },
          "incompatibility_reasons": {
            "description": "The complete sorted reason list when the two datasets are incompatible.",
            "items": {
              "$ref": "#/$defs/IncompatibilityReason"
            },
            "maxItems": 16,
            "type": "array"
          },
          "method": {
            "anyOf": [
              {
                "$ref": "#/$defs/Method"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent only when the pair was refused before any statistic was computed."
          }
        },
        "required": [
          "method",
          "comparisons",
          "compared",
          "comparisons_omitted",
          "baseline_only",
          "baseline_only_omitted",
          "candidate_only",
          "candidate_only_omitted",
          "incompatibility_reasons",
          "complete"
        ],
        "type": "object"
      },
      "Statistic": {
        "description": "The single statistic the frozen method compares.",
        "enum": [
          "median_per_iteration_nanoseconds"
        ],
        "type": "string"
      },
      "Verdict": {
        "description": "What the two measurements show under this method.",
        "oneOf": [
          {
            "const": "regression",
            "description": "The candidate measurement is materially slower than the baseline one.",
            "type": "string"
          },
          {
            "const": "improvement",
            "description": "The candidate measurement is materially faster than the baseline one.",
            "type": "string"
          },
          {
            "const": "no_material_change",
            "description": "The interval excludes a material difference in either direction.",
            "type": "string"
          },
          {
            "const": "inconclusive",
            "description": "No verdict is claimed; the reported reasons say why.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "properties": {
          "data": {
            "$ref": "#/$defs/Data"
          },
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          },
          "status": {
            "const": "passed",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "$ref": "#/$defs/Data"
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "failed",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "anyOf": [
              {
                "$ref": "#/$defs/Data"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "blocked",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "type": "null"
          },
          "error_code": {
            "$ref": "#/$defs/Code"
          },
          "error_message": {
            "type": "string"
          },
          "status": {
            "const": "unavailable",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      },
      {
        "properties": {
          "data": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          },
          "status": {
            "const": "cancelled",
            "type": "string"
          }
        },
        "required": [
          "status",
          "error_code",
          "error_message",
          "data"
        ],
        "type": "object"
      }
    ],
    "properties": {
      "duration_ms": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "summary",
      "duration_ms"
    ],
    "title": "Output",
    "type": "object",
    "unevaluatedProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
