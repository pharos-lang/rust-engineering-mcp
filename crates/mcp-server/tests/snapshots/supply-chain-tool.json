            "minimum": 0,
            "type": "integer"
          },
          "issue": {
            "anyOf": [
              {
                "$ref": "#/$defs/AuditIssue"
              },
              {
                "type": "null"
              }
            ]
          },
          "lock_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "packages_total": {
            "format": "uint32",
            "maximum": 4096,
            "minimum": 0,
            "type": "integer"
          },
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/$defs/RustSecEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_sequence": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "$ref": "#/$defs/AuditState"
          },
          "unsupported_packages": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "validation_complete": {
            "type": "boolean"
          },
          "workspace_packages_excluded": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "state",
          "issue",
          "validation_complete",
          "lock_fingerprint",
          "snapshot_fingerprint",
          "snapshot",
          "snapshot_sequence",
          "packages_total",
          "crates_io_scanned",
          "workspace_packages_excluded",
          "unsupported_packages",
          "findings",
          "findings_omitted"
        ],
        "type": "object"
      },
      "SupplyAvailability": {
        "enum": [
          "available",
          "partial",
          "unavailable",
          "invalid",
          "not_configured"
        ],
        "type": "string"
      },
      "SupplyCatalog": {
        "additionalProperties": false,
