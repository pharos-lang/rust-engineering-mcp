{
  "name": "rust.supply_chain.inspect",
  "description": "Inspect captured dependency facts, checksums, duplicates, features, one RustSec audit, dependency policy and exact-version yanked facts from one authenticated catalog generation. Missing sources and freshness remain explicit. Source locators are withheld; this is no security score or legal approval. Requires durable evidence; performs no acquisition. Auto or synchronous supports timeout_seconds at most 60; longer calls require negotiated MCP Tasks. The work budget excludes joined cleanup.",
  "inputSchema": {
    "$defs": {
      "ExecutionModeDto": {
        "enum": [
          "auto",
          "task",
          "synchronous"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "execution_mode": {
        "$ref": "#/$defs/ExecutionModeDto"
      },
      "project_ref": {
        "pattern": "^prj_[0-9a-f]{32}$",
        "type": "string"
      },
      "timeout_seconds": {
        "default": 120,
        "format": "uint64",
        "maximum": 120,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "project_ref"
    ],
    "title": "Input",
    "type": "object"
  },
  "outputSchema": {
    "$defs": {
      "Artifact": {
        "additionalProperties": false,
        "properties": {
          "completeness": {
            "$ref": "#/$defs/ArtifactCompleteness"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "uri": {
            "type": "string"
          }
        },
        "required": [
          "uri",
          "sha256",
          "size_bytes",
          "completeness"
        ],
        "type": "object"
      },
      "ArtifactCompleteness": {
        "enum": [
          "complete",
          "truncated",
          "partial",
          "invalid",
          "unavailable"
        ],
        "type": "string"
      },
      "AuditIssue": {
        "enum": [
          "snapshot_unavailable",
          "snapshot_stale",
          "snapshot_unknown_age",
          "unsupported_sources",
          "output_budget"
        ],
        "type": "string"
      },
      "AuditSource": {
        "enum": [
          "crates_io",
          "workspace",
          "unverified"
        ],
        "type": "string"
      },
      "AuditState": {
        "enum": [
          "passed",
          "failed",
          "incomplete",
          "unavailable"
        ],
        "type": "string"
      },
      "CatalogEvidence": {
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "$ref": "#/$defs/Freshness"
          },
          "provenance": {
            "$ref": "#/$defs/CatalogProvenance"
          }
        },
        "required": [
          "provenance",
          "freshness"
        ],
        "type": "object"
      },
      "CatalogProvenance": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "integrity": {
            "$ref": "#/$defs/IntegrityStatus"
          },
          "network_used": {
            "type": "boolean"
          },
          "observed_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "source_kind": {
            "$ref": "#/$defs/CatalogSourceKind"
          }
        },
        "required": [
          "source_kind",
          "source_id",
          "created_at",
          "observed_at",
          "integrity",
          "network_used"
        ],
        "type": "object"
      },
      "CatalogSourceKind": {
        "enum": [
          "registry_snapshot"
        ],
        "type": "string"
      },
      "Code": {
        "enum": [
          "TASKS_REQUIRED",
          "SANDBOX_DENIED",
          "MISSING_OFFLINE_DATA",
          "ARTIFACT_UNAVAILABLE",
          "TOOL_NOT_INSTALLED",
          "INVALID_PROJECT",
          "PROJECT_NOT_FOUND",
          "COMMAND_TIMEOUT",
          "OUTPUT_LIMIT_EXCEEDED",
          "EVIDENCE_INCOMPLETE"
        ],
        "type": "string"
      },
      "Data": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/$defs/Artifact"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          },
          "observation": {
            "$ref": "#/$defs/Observation"
          },
          "project_ref": {
            "type": "string"
          },
          "semantics": {
            "type": "string"
          }
        },
        "required": [
          "project_ref",
          "semantics",
          "observation",
          "artifacts"
        ],
        "type": "object"
      },
      "Disposition": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "state": {
                "const": "active",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "state": {
                "const": "suppressed",
                "type": "string"
              },
              "suppression": {
                "$ref": "#/$defs/Suppression"
              }
            },
            "required": [
              "state",
              "suppression"
            ],
            "type": "object"
          }
        ]
      },
      "Engine": {
        "enum": [
          "rustsec",
          "licenses",
          "bans",
          "sources"
        ],
        "type": "string"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "$ref": "#/$defs/Disposition"
          },
          "engine": {
            "$ref": "#/$defs/Engine"
          },
          "message": {
            "maxLength": 512,
            "type": "string"
          },
          "package": {
            "anyOf": [
              {
                "$ref": "#/$defs/Package"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule": {
            "maxLength": 96,
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          }
        },
        "required": [
          "engine",
          "rule",
          "package",
          "severity",
          "message",
          "disposition"
        ],
        "type": "object"
      },
      "Freshness": {
        "additionalProperties": false,
        "properties": {
          "age_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "assessed_at": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "policy": {
            "$ref": "#/$defs/FreshnessPolicy"
          },
          "state": {
            "$ref": "#/$defs/FreshnessState"
          }
        },
        "required": [
          "state",
          "age_seconds",
          "assessed_at",
          "policy"
        ],
        "type": "object"
      },
      "FreshnessPolicy": {
        "additionalProperties": false,
        "properties": {
          "fresh_for_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "stale_after_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "fresh_for_seconds",
          "stale_after_seconds"
        ],
        "type": "object"
      },
      "FreshnessState": {
        "enum": [
          "live",
          "fresh",
          "aging",
          "stale",
          "unknown"
        ],
        "type": "string"
      },
      "IntegrityStatus": {
        "enum": [
          "verified",
          "unverified",
          "failed",
          "unknown"
        ],
        "type": "string"
      },
      "Observation": {
        "additionalProperties": false,
        "properties": {
          "execution_fingerprint": {
            "type": "string"
          },
          "report": {
            "$ref": "#/$defs/SupplyReport"
          },
          "runtime": {
            "$ref": "#/$defs/RuntimeIdentity"
          }
        },
        "required": [
          "report",
          "runtime",
          "execution_fingerprint"
        ],
        "type": "object"
      },
      "Package": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/Source"
          },
          "source_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "source",
          "source_fingerprint"
        ],
        "type": "object"
      },
      "PolicyState": {
        "enum": [
          "satisfied",
          "satisfied_with_suppressions",
          "violated",
          "undetermined"
        ],
        "type": "string"
      },
      "RuntimeIdentity": {
        "additionalProperties": false,
        "properties": {
          "cargo_version": {
            "maxLength": 4096,
            "type": "string"
          },
          "configuration_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "declared_toolchain": {
            "maxLength": 6,
            "type": [
              "string",
              "null"
            ]
          },
          "execution_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "image_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "platform": {
            "maxLength": 4096,
            "type": "string"
          },
          "rust_version": {
            "maxLength": 4096,
            "type": "string"
          }
        },
        "required": [
          "platform",
          "image_id",
          "configuration_fingerprint",
          "execution_fingerprint",
          "rust_version",
          "cargo_version",
          "declared_toolchain"
        ],
        "type": "object"
      },
      "RustSecEvidence": {
        "additionalProperties": false,
        "properties": {
          "freshness": {
            "$ref": "#/$defs/Freshness"
          },
          "provenance": {
            "$ref": "#/$defs/RustSecProvenance"
          }
        },
        "required": [
          "provenance",
          "freshness"
        ],
        "type": "object"
      },
      "RustSecProvenance": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "integrity": {
            "$ref": "#/$defs/IntegrityStatus"
          },
          "network_used": {
            "type": "boolean"
          },
          "observed_at": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "source_kind": {
            "$ref": "#/$defs/RustSecSourceKind"
          }
        },
        "required": [
          "source_kind",
          "source_id",
          "created_at",
          "observed_at",
          "integrity",
          "network_used"
        ],
        "type": "object"
      },
      "RustSecSourceKind": {
        "enum": [
