      },
      "Severity": {
        "enum": [
          "error",
          "warning",
          "note",
          "help"
        ],
        "type": "string"
      },
      "Source": {
        "enum": [
          "workspace",
          "crates_io",
          "unverified"
        ],
        "type": "string"
      },
      "SupplyAdvisory": {
        "additionalProperties": false,
        "properties": {
          "advisory_id": {
            "type": "string"
          },
          "informational": {
            "type": "boolean"
          },
          "package_name": {
            "type": "string"
          },
          "package_source": {
            "$ref": "#/$defs/AuditSource"
          },
          "package_version": {
            "type": "string"
          },
          "source_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "advisory_id",
          "package_name",
          "package_version",
          "package_source",
          "source_fingerprint",
          "informational"
        ],
        "type": "object"
      },
      "SupplyAudit": {
        "additionalProperties": false,
        "properties": {
          "crates_io_scanned": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/SupplyAdvisory"
            },
            "maxItems": 128,
            "type": "array"
