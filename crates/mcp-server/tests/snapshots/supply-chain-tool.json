            "minimum": 0,
            "type": "integer"
          },
          "sequence": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "snapshot_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "availability",
          "snapshot_fingerprint",
          "bundle_fingerprint",
          "sequence",
          "evidence",
          "lookups"
