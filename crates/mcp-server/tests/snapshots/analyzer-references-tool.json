          "query_timeout_seconds",
          "total_timeout_seconds",
          "frame_bytes",
          "messages"
        ],
        "type": "object"
      },
      "Omission": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "$ref": "#/$defs/OmissionKind"
          }
        },
        "required": [
          "kind",
          "count"
        ],
        "type": "object"
      },
      "OmissionKind": {
        "description": "Mirrors `rust_engineering_domain::OmissionKind` 1:1; only `limit_visible`\nand `not_utf8_file` are reachable from this tool's converter today, but the\nfull closed set is modelled so a future gateway change needs no schema\nedit here. `oversized_entry` (V05 P2) is enforced by `lsp_codec` at the\npeer boundary, but the M6-01 gateway still folds that count into\n`limit_visible` pending a change to `analyzer_gateway.rs::record_omissions`\nthat reports it under this variant instead.",
        "enum": [
          "external_uri",
          "sysroot_location",
          "dependency_location",
          "limit_visible",
          "not_utf8_file",
          "unresolvable_position",
          "oversized_entry"
        ],
        "type": "string"
      },
      "Position": {
        "additionalProperties": false,
        "properties": {
          "column": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          },
          "line": {
            "format": "uint32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "line",
          "column"
        ],
        "type": "object"
      },
      "PositionEncoding": {
        "enum": [
          "utf-8",
          "utf-16"
        ],
        "type": "string"
      },
      "Range": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "$ref": "#/$defs/Position"
          },
          "start": {
            "$ref": "#/$defs/Position"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "Readiness": {
        "additionalProperties": false,
        "properties": {
          "elapsed_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "health": {
            "anyOf": [
              {
                "$ref": "#/$defs/Health"
              },
              {
                "type": "null"
              }
            ],
            "description": "`Some` only for `state: quiescent`: a never-ready session observed no\nserver health at all, and inventing one would be a claim the adapter\ncannot support."
          },
          "state": {
            "$ref": "#/$defs/ReadinessState"
          }
        },
        "required": [
          "state",
          "health",
          "elapsed_ms"
        ],
        "type": "object"
      },
      "ReadinessState": {
        "enum": [
          "quiescent",
          "not_ready"
        ],
        "type": "string"
      },
      "Reason": {
        "description": "Mirrors `rust_engineering_domain::IncompleteReason`, plus this tool's own\n`result_limit`: the 512 KiB output trim (D2) has no domain reason of its\nown because it never reaches the analyzer session at all.",
        "enum": [
          "analyzer_not_ready",
          "limit_visible",
          "analyzer_warning",
          "not_utf8_file",
          "timeout",
          "result_limit"
        ],
        "type": "string"
      },
      "Reference": {
        "additionalProperties": false,
        "description": "A `textDocument/references` result entry (ADR-084 §2 phase 6, amended).",
        "properties": {
          "file": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "is_declaration": {
            "description": "`true` for a location the `includeDeclaration: true` answer carries\nand the `includeDeclaration: false` answer does not (D25 R5); rust-\nanalyzer's own answer never flags this.",
            "type": "boolean"
          },
          "range": {
            "$ref": "#/$defs/Range"
          }
        },
        "required": [
          "file",
          "range",
          "is_declaration"
        ],
        "type": "object"
      },
      "ReferencesCode": {
        "enum": [
          "CONFLICT",
          "FILE_NOT_IN_SNAPSHOT",
          "POSITION_OUT_OF_RANGE",
          "ANALYZER_NOT_READY",
          "ANALYZER_CRASHED",
          "ANALYZER_CAPABILITY_MISMATCH",
          "FRAME_LIMIT",
          "MESSAGE_LIMIT",
          "RESULT_LIMIT",
          "TIMEOUT_INITIALIZE",
          "TIMEOUT_QUERY",
          "TIMEOUT_TOTAL",
          "UNSUPPORTED_PROJECT_CONFIG",
          "FILE_NOT_UTF8",
          "SANDBOX_DENIED",
          "UNSUPPORTED_PLATFORM",
          "PROJECT_NOT_FOUND",
          "INVALID_PROJECT",
          "OUTPUT_LIMIT_EXCEEDED"
