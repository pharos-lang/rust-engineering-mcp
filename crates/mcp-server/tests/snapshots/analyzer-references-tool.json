            "minimum": 0,
            "type": "integer"
          },
          "messages": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "query_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "total_timeout_seconds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
