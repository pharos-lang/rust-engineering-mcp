              "$ref": "#/$defs/RankedCrate"
            },
            "type": "array"
          },
          "semantic_index": {
            "anyOf": [
              {
                "$ref": "#/$defs/IndexMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_fingerprint": {
            "$ref": "#/$defs/Fingerprint"
          },
          "window": {
            "$ref": "#/$defs/SearchWindow"
          }
        },
        "required": [
          "requested_mode",
          "effective_mode",
          "fallback",
          "snapshot_fingerprint",
          "evidence",
          "semantic_index",
          "model_evidence",
          "results",
          "window"
        ],
        "type": "object"
      },
      "Data": {
