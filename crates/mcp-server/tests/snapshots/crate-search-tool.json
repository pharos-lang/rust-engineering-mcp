          "yanked",
          "rust_version",
          "license"
        ],
        "type": "object"
      },
      "LexicalScore": {
        "additionalProperties": false,
        "properties": {
          "bm25": {
            "format": "double",
            "type": "number"
          },
          "rank": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "rank",
