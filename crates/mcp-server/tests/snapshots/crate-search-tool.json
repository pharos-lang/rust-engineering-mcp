        "type": "string"
      },
      "Code": {
        "enum": [
          "SANDBOX_DENIED",
          "COMMAND_TIMEOUT",
          "OUTPUT_LIMIT_EXCEEDED",
          "CATALOG_UNAVAILABLE",
          "CATALOG_INVALID"
        ],
        "type": "string"
      },
      "Coverage": {
        "enum": [
          "candidate_window_only"
        ],
        "type": "string"
      },
      "CrateSearchMode": {
        "enum": [
          "lexical",
          "semantic",
          "hybrid"
        ],
        "type": "string"
      },
