{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Search the verified local snapshot with lexical, semantic or hybrid retrieval and authoritative SQLite version filters. Scores measure retrieval, not crate quality or safety. Bounded candidate windows and output omissions are explicit; unavailable semantics fall back to lexical with the same filters. No downloads, refresh or project authority.",
  "inputSchema": {
    "$defs": {
      "CrateSearchMode": {
        "enum": [
          "lexical",
          "semantic",
          "hybrid"
        ],
        "type": "string"
      },
      "Filters": {
        "additionalProperties": false,
        "properties": {
          "allow_yanked": {
            "default": false,
            "type": "boolean"
          },
          "include_prerelease": {
            "default": false,
            "type": "boolean"
          },
          "msrv_lte": {
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "filters": {
        "$ref": "#/$defs/Filters",
        "default": {
          "allow_yanked": false,
          "include_prerelease": false,
          "msrv_lte": null
        }
      },
      "limit": {
        "default": 10,
        "format": "uint32",
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "mode": {
        "$ref": "#/$defs/CrateSearchMode",
        "default": "hybrid"
      },
      "query": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "title": "Input",
    "type": "object"
  },
  "name": "rust.crate.search",
  "outputSchema": {
    "$defs": {
      "AdvisoryInterpretation": {
        "enum": [
          "snapshot_listed_ids_only"
        ],
        "type": "string"
      },
      "CatalogComponentUnavailable": {
        "enum": [
          "not_configured",
          "missing",
          "invalid",
          "identity_mismatch",
          "unsupported_platform",
          "feature_disabled",
          "denied",
          "io_unavailable",
          "budget",
          "dependency_unavailable"
