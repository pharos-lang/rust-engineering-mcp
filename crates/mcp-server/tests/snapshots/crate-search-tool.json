            "type": "integer"
          },
          "intra_threads": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "max_tokens": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "model": {
