.DS_Store
/target/
/.idea/
/.vscode/
*.log
*.profraw
__pycache__/
*.py[cod]
/coverage/

# Client homes that qualification harnesses point at a client binary carry
# OAuth tokens and session databases.  They are credential material and
# per-attempt scratch state, never evidence, so they must never be stageable.
codex-home/
auth.json
installation_id
.netrc
credentials.json
.env
docs/validation/**/*.sqlite
docs/validation/**/*.sqlite-shm
docs/validation/**/*.sqlite-wal

# Private store state written by the client-qualification harnesses under each
# attempt (artifact blobs, store.lock, clock watermark, copied seccomp
# profiles). Scratch state, never evidence: docs/validation/M<n>/history/
# inventory.json records the aggregate hash of every retired directory.
docs/validation/**/state-*/

# Raw M3 delegation agent transcripts (~41 MB of JSONL). They stay on disk;
# docs/validation/M3/delegation-log-inventory.json records their size and
# digest and names the files from each package that are committed.
docs/validation/M3/delegation/**/stdout.txt

# Python bytecode from the provisioning and fixture scripts.
/.claude/settings.local.json
*.profdata
.coverage
.coverage.*
**/__pycache__/**

# OS and editor droppings, patch leftovers, probe build directories and
# packaging output. `.DS_Store` above has no slash, so it already matches at
# every depth.
*.dSYM/
*.orig
*.rej
*.swp
.pytest_cache/
node_modules/
target-*/
dist/
*.tar.gz
# Captured crates ship Cargo.toml.orig and fixtures may ship archives: those
# stay stageable so a re-vendor or a new fixture cannot silently drop them.
!vendor/**/Cargo.toml.orig
!fixtures/**/Cargo.toml.orig
!docs/research/**/Cargo.toml.orig
!fixtures/**/*.tar.gz
